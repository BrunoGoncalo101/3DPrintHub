# Copia este ficheiro para .env e preenche. NUNCA faças commit do .env.
# Os valores reais são enviados em privado pelo B (DBA).

# Aiven (MySQL). Base de desenvolvimento: loja_dev
DB_URL=jdbc:mysql://HOST:PORTA/loja_dev?sslMode=REQUIRED
DB_USER=
DB_PASSWORD=

# Chave para assinar os tokens JWT (string longa e aleatória)
JWT_SECRET=

# Pasta dos ficheiros 3D (opcional)
UPLOADS_DIR=uploads
